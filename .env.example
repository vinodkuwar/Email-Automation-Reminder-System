# ==============================================================================
# Email Automation & Reminder System - Environment Configuration
# ==============================================================================

# Operation Mode: 'dry_run' (default, safe simulation) or 'real' (live SMTP)
EMAIL_MODE=dry_run

# SMTP Server Configuration (Only required when EMAIL_MODE=real)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender Identity
FROM_NAME=Email Automation Reminder System
FROM_EMAIL=reminders@system.local

# Background Scheduler Polling Interval in seconds
SCHEDULER_INTERVAL_SECONDS=10
